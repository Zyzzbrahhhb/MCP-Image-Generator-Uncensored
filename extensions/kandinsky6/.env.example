# Kandinsky 6 video extension settings for this computer. The setup writes extensions/kandinsky6/.env from these.
#
# VIDEO_GPU     the card, by UUID (nvidia-smi -L) or index.
# VIDEO_MODE    how the model uses that card (measured at 864x480, 5 s, with sound):
#                 resident    everything on the GPU, ~17 GB     (24 GB+ cards; RTX 5090: 43-70 s)
#                 fast        parts visit the GPU in turn, ~11 GB (16 GB+ cards)
#                 low-memory  like fast with a cap, ~8.5-10 GB  (10-12 GB cards; RTX 3080 Ti: 115-122 s)
#                 stream      weights stream from RAM, ~5.5 GB  (8 GB cards, or sharing a 12 GB card; 139-147 s)
# VIDEO_CAP_GB  PyTorch memory cap in GiB (empty: the mode's default).
# SHARES_IMAGE_GPU  yes when the image model uses the same card (the server then runs one job at a time on
#                   cards of 12 GB or less; see extensions.max_jobs in config.yaml).
# GPU_GB        the card's memory in GB.
VIDEO_GPU=0
VIDEO_MODE=low-memory
VIDEO_CAP_GB=
VIDEO_MEM_LIMIT=20g
VIDEO_IDLE_UNLOAD_SECONDS=600
SHARES_IMAGE_GPU=no
GPU_GB=12
